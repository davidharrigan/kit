# Codex stores credentials and runtime state alongside its configuration.
# Only these reviewed configuration files belong in the repository.
/modules/dots/codex/*
!/modules/dots/codex/default.nix
!/modules/dots/codex/config.pinned.toml
!/modules/dots/codex/hooks.json
!/modules/dots/codex/keybindings.json
!/modules/dots/codex/herdr-agent-state.sh

# nix build output
result

# machine capture output (local only; capture.sh is tracked)
baseline/*/

/modules/dots/claude/skills/synced

/*/env/*.env
