{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  // ── Sidebar: one row per project — name, branch, path. Nothing else. ──
  //
  // These toggles are global, not per-workspace. The split still works out:
  // the rows turned off below auto-populate on ANY workspace, while
  // showCustomMetadata and showProgress only render when something explicitly
  // sets them (cmux set-status / set-progress) — in practice, only agents.
  // So personal workspaces stay bare and agent workspaces keep their pills.
  "sidebar": {
    "showBranchDirectory": true,      // path
    "branchLayout": "vertical",       // branch
    "showCustomMetadata": true,       // agent status pills — /task orchestrators
    "showProgress": true,             // agent progress bars
    "showNotificationMessage": false, // was up to 12 lines of agent chatter
    "showLog": false,
    "showPorts": false,
    "showPullRequests": false,        // flip to true to get PR status inline
    "showSSH": false,

    // Below: unmodified — pinned to schema default, confirmed absent from
    // Settings UI storage (~/Library/Preferences/com.cmuxterm.app.plist).
    "hideAllDetails": false,
    "openPortLinksInCmuxBrowser": true,
    "openPullRequestLinksInCmuxBrowser": true,
    "wrapWorkspaceTitles": false,
    "showWorkspaceDescription": true,
    "beta": {
      "workspaceTodos": {
        "checklistStyle": "popover"
      }
    },
    "notificationMessageLineLimit": 12,
    "watchGitStatus": true,
    "makePullRequestsClickable": true,
    "showAgentActivity": true,
    "loadingSpinnerPosition": "leading",
    "notificationBadgePosition": "leading"
    // rightMaxWidth omitted — schema defines no default (built-in dynamic cap applies)
  },

  // Stop agent activity from reordering the sidebar under you.
  "app": {
    "reorderOnNotification": false,
    "iMessageMode": false,

    // Below: unmodified — pinned to schema default, confirmed absent from
    // Settings UI storage (~/Library/Preferences/com.cmuxterm.app.plist).
    "language": "system",
    "appearance": "system",
    "appIcon": "automatic",
    "windowTitleTemplate": "",
    "menuBarOnly": false,
    "newWorkspacePlacement": "afterCurrent",
    "forkConversationDefaultDestination": "right",
    "workspaceInheritWorkingDirectory": true,
    "minimalMode": false,
    "keepWorkspaceOpenWhenClosingLastSurface": false,
    "focusPaneOnFirstClick": true,
    "focusHistoryIncludesPanesAndTabs": false,
    "preferredEditor": "",
    "openSupportedFilesInCmux": true,
    "openMarkdownInCmuxViewer": true,
    "globalFontMagnification": 100,
    "sendAnonymousTelemetry": true,
    "confirmQuit": "always",
    "warnBeforeQuit": true,
    "warnBeforeClosingTab": true,
    "warnBeforeClosingTabXButton": false,
    "hideTabCloseButton": false,
    "renameSelectsExistingName": true,
    "commandPaletteSearchesAllSurfaces": false
  },

  // Note: AI workspace auto-naming lives at automation.workspaceAutoNaming and
  // is left as-is (managed in Settings). It never overwrites a name you set —
  // so name a workspace once and it is permanently opted out.

